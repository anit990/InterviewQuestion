WITH EmployeeHierarchy AS
(
    -- Anchor Query
    SELECT
        Id,
        Name,
        ManagerId,
        0 AS Level
    FROM Employees
    WHERE ManagerId IS NULL

    UNION ALL

    -- Recursive Query
    SELECT
        e.Id,
        e.Name,
        e.ManagerId,
        eh.Level + 1
    FROM Employees e
    INNER JOIN EmployeeHierarchy eh
        ON e.ManagerId = eh.Id
)
SELECT *
FROM EmployeeHierarchy
ORDER BY Level;
